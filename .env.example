# Kopie tohoto souboru jako .env slouží pro lokální/produkční přepsání dev defaultů
# z app/config.py. Nic z tohoto souboru se necommituje s reálnými hodnotami — .env je
# v .gitignore, tento .env.example zůstává v repu jako vzor bez tajemství.

# --- Aplikace ---
# Tajný klíč pro podepisování session cookie. V produkci vygenerovat náhodně
# (např. `python -c "import secrets; print(secrets.token_hex(32))"`).
APP_SECRET_KEY=change-me-to-a-random-secret

# Připojení k databázi (SQLite soubor).
DATABASE_URL=sqlite:///./registr.db

# --- LLM ---
# Poskytovatel LLM: "mock" (offline, bez klíče, deterministický) nebo "anthropic".
LLM_PROVIDER=mock

# API klíč pro Anthropic — povinný jen když LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# Model použitý při LLM_PROVIDER=anthropic.
ANTHROPIC_MODEL=claude-sonnet-5

# Timeout jednoho volání LLM ve vteřinách.
LLM_TIMEOUT_SECONDS=10

# Kolik dní se uchovávají metadata v LLM auditu, než se při startu smažou.
LLM_AUDIT_RETENTION_DAYS=90

# Demo přepínač: mock adapter vždy selže (timeout) — ukázka fallbacku bez sítě.
LLM_FORCE_FAIL=false

# --- OIDC / Keycloak ---
# Veřejná URL vydavatele tokenu — používá ji prohlížeč (authorize endpoint).
OIDC_ISSUER_URL=http://localhost:8080/realms/registr

# Backchannel URL — používá backend (token / jwks / userinfo endpoint). Při běhu
# uvicornu na hostu je shodná s veřejnou; v docker-compose síti se nastaví na
# `http://keycloak:8080/realms/registr`. Issuer v tokenu zůstává vždy veřejný.
OIDC_INTERNAL_URL=http://localhost:8080/realms/registr

OIDC_CLIENT_ID=registr-app

# Musí odpovídat `secret` clienta v keycloak/realm-export.json. Hodnota níže je
# vývojová (realm se importuje jen do lokálního dev Keycloaku) — v produkci
# vygenerovat v IdP a předat sem přes secret manager.
OIDC_CLIENT_SECRET=dev-oidc-client-secret

# Název claimu v tokenu, kde jsou role uživatele.
OIDC_ROLES_CLAIM=roles

# --- Session / cookies ---
# Maximální stáří přihlašovací session v sekundách (default 8 hodin).
SESSION_MAX_AGE=28800

# Cookie jen přes HTTPS — v lokálním dev nastavit na false, v produkci vždy true.
COOKIE_SECURE=false
